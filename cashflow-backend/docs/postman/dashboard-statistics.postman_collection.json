{
  "info": {
    "_postman_id": "9b8f1673-6d87-4cf7-b223-2db372633611",
    "name": "Cashflow Backend - Dashboard Statistics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for testing dashboard statistics endpoint."
  },
  "item": [
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Statistics - Current Month",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('token')) {",
                  "  console.warn('Collection variable `token` is empty. Set token before sending authenticated requests.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response status is success', function () {",
                  "  const responseBodyJson = pm.response.json();",
                  "  pm.expect(responseBodyJson).to.have.property('status', 'success');",
                  "});",
                  "",
                  "pm.test('Response has dashboard data shape', function () {",
                  "  const responseBodyJson = pm.response.json();",
                  "  pm.expect(responseBodyJson).to.have.property('data');",
                  "  pm.expect(responseBodyJson.data).to.have.property('period');",
                  "  pm.expect(responseBodyJson.data.period).to.have.property('month');",
                  "  pm.expect(responseBodyJson.data.period).to.have.property('year');",
                  "  pm.expect(responseBodyJson.data).to.have.property('totalBalance');",
                  "  pm.expect(responseBodyJson.data).to.have.property('totalIncome');",
                  "  pm.expect(responseBodyJson.data).to.have.property('totalExpense');",
                  "});",
                  "",
                  "pm.test('Period values are valid', function () {",
                  "  const responseBodyJson = pm.response.json();",
                  "  pm.expect(responseBodyJson.data.period.month).to.be.within(1, 12);",
                  "  pm.expect(responseBodyJson.data.period.year).to.be.a('number');",
                  "  pm.expect(responseBodyJson.data.period.year).to.be.within(1900, 2100);",
                  "});",
                  "",
                  "pm.test('Totals are numeric', function () {",
                  "  const responseBodyJson = pm.response.json();",
                  "  pm.expect(responseBodyJson.data.totalBalance).to.be.a('number');",
                  "  pm.expect(responseBodyJson.data.totalIncome).to.be.a('number');",
                  "  pm.expect(responseBodyJson.data.totalExpense).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Response time is less than 1000ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/statistics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "statistics"
              ]
            },
            "description": "Get dashboard statistics for current month."
          },
          "response": []
        },
        {
          "name": "Get Statistics - Custom Month",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('month')) {",
                  "  pm.collectionVariables.set('month', String(new Date().getMonth() + 1));",
                  "}",
                  "",
                  "if (!pm.collectionVariables.get('year')) {",
                  "  pm.collectionVariables.set('year', String(new Date().getFullYear()));",
                  "}",
                  "",
                  "if (!pm.collectionVariables.get('token')) {",
                  "  console.warn('Collection variable `token` is empty. Set token before sending authenticated requests.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response period matches requested month/year', function () {",
                  "  const responseBodyJson = pm.response.json();",
                  "  pm.expect(responseBodyJson.data.period.month).to.eql(Number(pm.collectionVariables.get('month')));",
                  "  pm.expect(responseBodyJson.data.period.year).to.eql(Number(pm.collectionVariables.get('year')));",
                  "});",
                  "",
                  "pm.test('Totals are numeric', function () {",
                  "  const responseBodyJson = pm.response.json();",
                  "  pm.expect(responseBodyJson.data.totalBalance).to.be.a('number');",
                  "  pm.expect(responseBodyJson.data.totalIncome).to.be.a('number');",
                  "  pm.expect(responseBodyJson.data.totalExpense).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/statistics?month={{month}}&year={{year}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "statistics"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "{{month}}"
                },
                {
                  "key": "year",
                  "value": "{{year}}"
                }
              ]
            },
            "description": "Get dashboard statistics for selected month and year."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "month",
      "value": "3",
      "type": "string"
    },
    {
      "key": "year",
      "value": "2026",
      "type": "string"
    }
  ]
}
