                "type": "text/javascript",
                "exec": [
                  "const requiredVars = ['token', 'categoryId', 'month', 'year'];",
                  "const missingVars = requiredVars.filter((key) => !pm.collectionVariables.get(key));",
                  "if (missingVars.length > 0) {",
                  "  throw new Error(`Missing required collection variables for Set Budget: ${missingVars.join(', ')}.`);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Save budgetId if available', function () {",
                  "  const responseBodyJson = pm.response.json();",
                  "  const budget = responseBodyJson?.data?.budget;",
                  "  if (budget && budget.id) {",
                  "    pm.collectionVariables.set('budgetId', budget.id);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
