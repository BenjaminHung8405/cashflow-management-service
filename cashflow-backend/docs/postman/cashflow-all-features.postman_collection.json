        {
          "name": "Create Transaction",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('transactionDate')) {",
                  "  pm.collectionVariables.set('transactionDate', new Date().toISOString());",
                  "}",
                  "",
                  "const requiredVars = ['token', 'walletId', 'categoryId'];",
                  "const missingVars = requiredVars.filter((key) => !pm.collectionVariables.get(key));",
                  "if (missingVars.length > 0) {",
                  "  throw new Error(`Missing required collection variables for Create Transaction: ${missingVars.join(', ')}. Run Login, Create/Get Category, and Create/Get Wallet first.`);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Save transactionId', function () {",
                  "  const responseBodyJson = pm.response.json();",
                  "  pm.expect(responseBodyJson.data).to.have.property('transaction');",
                  "  pm.expect(responseBodyJson.data.transaction).to.have.property('id');",
                  "  pm.collectionVariables.set('transactionId', responseBodyJson.data.transaction.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
